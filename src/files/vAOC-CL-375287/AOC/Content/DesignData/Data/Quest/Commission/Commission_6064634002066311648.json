	"commissionName": "NSLOCTEXT(\"[70199B914E7E03A9706A1499CF20B1FD]\", \"64BA366145B5CBD85A7EBEA43BD706FB\", \"Straying from the Beaten Path\")",
	"flavorText": "NSLOCTEXT(\"[70199B914E7E03A9706A1499CF20B1FD]\", \"58C0391A49EF30E93A9600A153F6DE19\", \"A pair of explorers veered from the path to Bonfire. They were lured by tales of a mystical pool hidden off the Dunbreak Flow. Their guide, unable to endure the relentless perils, abandoned them. Now lost in the dark, their odds of survival dwindle with each passing hour. Only a bold adventurer, or a reckless one, would dare venture into those depths to find them.\")",
	"mainObjectiveText": "NSLOCTEXT(\"[70199B914E7E03A9706A1499CF20B1FD]\", \"36F4654C4ECD903951987B944AF10621\", \"Search the caves for the lost explorers\")",
