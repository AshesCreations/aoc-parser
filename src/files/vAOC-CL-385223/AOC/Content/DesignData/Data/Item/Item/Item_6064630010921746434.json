	"itemName": "NSLOCTEXT(\"[1909495A4C2095068D406C9D33F90055]\", \"1CF6511146C34ED23AA81AA8C7CBC150\", \"Phoenix Gryphon\")",
	"description": "NSLOCTEXT(\"[D20C99C24B2FABB4DC05E3BF1EE067C5]\", \"8BC2426F46E2E3DD5A69889AFF14B9DB\", \"Flying Mount\\r\\nLevel 25\\r\\n\\r\\n165% Ground Speed\\r\\n215% Flying Speed\\r\\n500% Maximum Health\")",
