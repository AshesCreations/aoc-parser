	"itemName": "NSLOCTEXT(\"\", \"EA1C1C3A4B1C8AFA796C449625C0471E\", \"Horse\")",
	"description": "NSLOCTEXT(\"[1909495A4C2095068D406C9D33F90055]\", \"8C043CB64F4C30659BA961B0B76B75BE\", \"Ground Mount\\r\\nLevel 1\\r\\n\\r\\n135% Ground Speed\")",
