			{
				"expression": "// if this is changed make sure to update \"evenweight\" curves\r\nconst numWeights = 8;\r\nconst weight = GetNpcStatDistribution(GetOwner(), EStatDistributionStat::Constitution);\r\nconst totalStats = EvalCurve($#10516612381411114:6064631783354597376$, Float(GetCharacterLevel(GetOwner())));\r\nconst statBase = EvalCurve($#10516612381411114:6064630328355258373$, Float(GetCharacterLevel(GetOwner())));\r\nconst ratingPerAttrib = EvalE($#10516612381411112:6064631924704346208$);\r\nconst gearAttribRatio = EvalE($#10516612381411112:6064631901772120296$);\r\nGetStatInitRunningTotal()\r\n+ statBase * weight * numWeights\r\n+ totalStats * weight / ratingPerAttrib * gearAttribRatio"
			}
		},
